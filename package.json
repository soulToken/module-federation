{
  "name": "hyper-module-federation-mesh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "去中心化 Module Federation 2.0 对等微前端系统：包含 hyper-core、hyper-mall、hyper-activity、hyper-user 全部独立部署",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter hyper-core build",
    "build:all": "node ./scripts/build-unified.mjs",
    "deploy:vercel": "pnpm run build:all && npx vercel deploy --prebuilt --prod --yes",
    "rollback": "node ./scripts/rollback.mjs",
    "ab-test": "node ./scripts/ab-test.mjs",
    "ab": "node ./scripts/ab-test.mjs",
    "serve:prod": "node ./scripts/prod-server.mjs",
    "dev:core": "pnpm --filter hyper-core dev",
    "dev:mall": "pnpm --filter @hyper/mall dev",
    "dev:activity": "pnpm --filter @hyper/activity dev",
    "dev:user": "pnpm --filter @hyper/user dev"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.22.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.0",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "vue-router": "^5.3.1"
  }
}
